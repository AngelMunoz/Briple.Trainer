module Briple.Trainer.Core.Plan.Data

#nowarn "3535"

// The agent data boundary: the model answers JSON, JDeck decodes it
// tolerantly (missing or null fields, an answer wrapped in {"data": ...})
// and this module validates the decoded data before building the domain.
// The model never writes the file format; the format is generated by
// Plan.Writer deterministically.

open System.Text.Json
open JDeck
open Briple.Trainer.Core.Plan.Types

/// Converts the model's JSON into a domain Plan. Invalid fields
/// accumulate as DataFailure values (the IPlanDataError leaf, so the
/// caller's edge composes them without mapError); the day must carry a
/// recognized name and the gender must be male or female.
val fromJson<'e when IPlanDataError<'e>> : json: string -> Result<Plan, 'e>

/// Serializes the plan's block of the given gender as the JSON the model
/// receives as reference in the adjustment flow; None when the plan has
/// no block for it.
val toJson: gender: Gender * plan: Plan -> string option

/// The model's answer root: {"data": ...} wrappers (object or string)
/// unwrapped, the raw root otherwise. The element is cloned, so the
/// document it came from is closed. Shared by every decoder that reads
/// a model answer.
val answerRoot: json: string -> Result<JsonElement, string>

/// An optional string field: absent, null and present all read.
val inline readString:
  key: string * element: JsonElement -> Result<string option, DecodeError>
