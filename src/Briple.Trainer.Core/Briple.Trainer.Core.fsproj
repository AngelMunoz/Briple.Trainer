<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- test scripts load the Core DLLs from its bin -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Parser.fsi" />
    <Compile Include="Parser.fs" />
    <Compile Include="Projection.fsi" />
    <Compile Include="Projection.fs" />
    <Compile Include="Prescription.fsi" />
    <Compile Include="Prescription.fs" />
    <Compile Include="Athletes.fsi" />
    <Compile Include="Athletes.fs" />
    <Compile Include="Memories.fsi" />
    <Compile Include="Memories.fs" />
    <Compile Include="Goals.fsi" />
    <Compile Include="Goals.fs" />
    <Compile Include="Parameters.fsi" />
    <Compile Include="Parameters.fs" />
    <Compile Include="Requests.fsi" />
    <Compile Include="Requests.fs" />
    <Compile Include="Instructions.fsi" />
    <Compile Include="Instructions.fs" />
    <Compile Include="Wizard.fsi" />
    <Compile Include="Wizard.fs" />
    <Compile Include="Plan.Writer.fsi" />
    <Compile Include="Plan.Writer.fs" />
    <Compile Include="Plan.Data.fsi" />
    <Compile Include="Plan.Data.fs" />
    <Compile Include="Validator.fsi" />
    <Compile Include="Validator.fs" />
    <Compile Include="Prompts.fsi" />
    <Compile Include="Prompts.fs" />
    <Compile Include="Agent.fsi" />
    <Compile Include="Agent.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Format: the parser stays on XParsec, as in Briple -->
    <PackageReference Include="XParsec" />
    <PackageReference Include="JDeck" />
  </ItemGroup>

  <ItemGroup>
    <!-- Agent: BYOK OpenAI-compatible (DeepSeek, Meta Muse) -->
    <PackageReference Include="IcedTasks" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="FsToolkit.ErrorHandling" />
    <!-- ILogger for the agent boundary; Serilog plugs in at the app -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
