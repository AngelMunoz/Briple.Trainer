<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- test scripts load the Core DLLs from its bin -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Parser.fsi" />
    <Compile Include="Parser.fs" />
    <Compile Include="Projection.fsi" />
    <Compile Include="Projection.fs" />
    <Compile Include="Athletes.fsi" />
    <Compile Include="Athletes.fs" />
    <Compile Include="Memories.fsi" />
    <Compile Include="Memories.fs" />
    <Compile Include="Parameters.fsi" />
    <Compile Include="Parameters.fs" />
    <Compile Include="Solicitudes.fsi" />
    <Compile Include="Solicitudes.fs" />
    <Compile Include="Instrucciones.fsi" />
    <Compile Include="Instrucciones.fs" />
    <Compile Include="Wizard.fsi" />
    <Compile Include="Wizard.fs" />
    <Compile Include="Plan.Escritor.fsi" />
    <Compile Include="Plan.Escritor.fs" />
    <Compile Include="Plan.Datos.fsi" />
    <Compile Include="Plan.Datos.fs" />
    <Compile Include="Validador.fsi" />
    <Compile Include="Validador.fs" />
    <Compile Include="Prompts.fsi" />
    <Compile Include="Prompts.fs" />
    <Compile Include="Agente.fsi" />
    <Compile Include="Agente.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Format: the parser stays on XParsec, as in Briple -->
    <PackageReference Include="XParsec" />
    <PackageReference Include="JDeck" />
  </ItemGroup>

  <ItemGroup>
    <!-- Agent: BYOK OpenAI-compatible (DeepSeek, Meta Muse) -->
    <PackageReference Include="IcedTasks" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

</Project>
