<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI: Avalonia 12 + NXUI + Navs + MVUish -->
    <!-- 12.0.5: the version Navs.Avalonia 1.0.0 and MVUish.Avalonia 1.0.0
         are verified against; NXUI 12.0.0 ships 12.0.0 satellite packages,
         so a higher core mixes versions in one graph -->
    <PackageVersion Include="Avalonia" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Headless" Version="12.0.5" />
    <PackageVersion Include="NXUI" Version="12.0.0" />
    <PackageVersion Include="NXUI.Desktop" Version="12.0.0" />
    <PackageVersion Include="Navs.Avalonia" Version="1.0.0" />
    <PackageVersion Include="MVUish.Avalonia" Version="1.0.0" />

    <!-- Data -->
    <PackageVersion Include="Donald" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Migrondi.Core" Version="1.3.0" />
    <!-- transitively pinned: Migrondi pulls a vulnerable 9.0.11 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- DPAPI (Windows) for the OS-secured agent token -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />

    <!-- Formato del plan (parser, como en Briple) -->
    <PackageVersion Include="XParsec" Version="1.0.0" />

    <!-- Tests -->
    <PackageVersion Include="Expecto" Version="11.1.1" />

    <!-- Core utilities -->
    <PackageVersion Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageVersion Include="IcedTasks" Version="0.11.9" />
    <PackageVersion Include="JDeck" Version="1.1.0" />

    <!-- IA: BYOK OpenAI-compatible (GLM, DeepSeek, Meta Muse) -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="AgentNet" Version="0.2.0" />

    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>
